{
  "grammar": [
    {
      "id": "copula",
      "category": "basics",
      "title_it": "Essere: です",
      "title_en": "Being: です",
      "description_it": "Usa です per identificarti.",
      "description_en": "Use です to identify yourself.",
      "pattern": "N は N です"
    },
    {
      "id": "negative",
      "category": "basics",
      "title_it": "Negazione nominale",
      "title_en": "Negative copula",
      "description_it": "じゃありません nega un nome.",
      "description_en": "じゃありません negates a noun.",
      "pattern": "N は N じゃありません"
    },
    {
      "id": "question",
      "category": "basics",
      "title_it": "Domande con か",
      "title_en": "Questions with か",
      "description_it": "か conclude una domanda cortese.",
      "description_en": "か ends a polite question.",
      "pattern": "N は N ですか"
    },
    {
      "id": "possession",
      "category": "particles",
      "title_it": "Possesso con の",
      "title_en": "Possession with の",
      "description_it": "の collega il possessore al nome.",
      "description_en": "の connects a possessor to a noun.",
      "pattern": "N の N"
    },
    {
      "id": "object",
      "category": "particles",
      "title_it": "Oggetto con を",
      "title_en": "Object with を",
      "description_it": "を indica l’oggetto diretto.",
      "description_en": "を marks the direct object.",
      "pattern": "N を Vます"
    },
    {
      "id": "destination",
      "category": "particles",
      "title_it": "Destinazione con に",
      "title_en": "Destination with に",
      "description_it": "に indica la destinazione con 行く.",
      "description_en": "に marks the destination with 行く.",
      "pattern": "N に 行きます"
    },
    {
      "id": "location",
      "category": "particles",
      "title_it": "Luogo di un’azione con で",
      "title_en": "Action location with で",
      "description_it": "で indica dove avviene un’azione.",
      "description_en": "で marks where an action happens.",
      "pattern": "N で Vます"
    },
    {
      "id": "time",
      "category": "particles",
      "title_it": "Orario con に",
      "title_en": "Time with に",
      "description_it": "に segue un orario preciso.",
      "description_en": "に follows a specific time.",
      "pattern": "時 に Vます"
    },
    {
      "id": "also",
      "category": "particles",
      "title_it": "Anche con も",
      "title_en": "Also with も",
      "description_it": "も aggiunge un elemento simile.",
      "description_en": "も adds a similar item.",
      "pattern": "N も N です"
    },
    {
      "id": "past",
      "category": "verbs",
      "title_it": "Passato cortese",
      "title_en": "Polite past",
      "description_it": "ました esprime un’azione passata.",
      "description_en": "ました expresses a past action.",
      "pattern": "Vました"
    },
    {
      "id": "verb-negative",
      "category": "verbs",
      "title_it": "Negazione cortese",
      "title_en": "Polite negative",
      "description_it": "ません nega un’azione.",
      "description_en": "ません negates an action.",
      "pattern": "Vません"
    },
    {
      "id": "past-negative",
      "category": "verbs",
      "title_it": "Passato negativo",
      "title_en": "Negative past",
      "description_it": "ませんでした nega un’azione passata.",
      "description_en": "ませんでした negates a past action.",
      "pattern": "Vませんでした"
    },
    {
      "id": "request",
      "category": "verbs",
      "title_it": "Richieste con ください",
      "title_en": "Requests with ください",
      "description_it": "Usa la forma て con ください.",
      "description_en": "Use the て form with ください.",
      "pattern": "Vて ください"
    },
    {
      "id": "progressive",
      "category": "verbs",
      "title_it": "Azioni in corso",
      "title_en": "Actions in progress",
      "description_it": "ている descrive un’azione in corso.",
      "description_en": "ている describes an ongoing action.",
      "pattern": "Vて います"
    },
    {
      "id": "invitation",
      "category": "verbs",
      "title_it": "Inviti con ませんか",
      "title_en": "Invitations with ませんか",
      "description_it": "ませんか propone un’attività.",
      "description_en": "ませんか proposes an activity.",
      "pattern": "Vませんか"
    },
    {
      "id": "desire",
      "category": "verbs",
      "title_it": "Desideri con たい",
      "title_en": "Wishes with たい",
      "description_it": "たい esprime ciò che desideri fare.",
      "description_en": "たい expresses what you want to do.",
      "pattern": "Vたいです"
    },
    {
      "id": "existence",
      "category": "existence",
      "title_it": "Esistenza con あります",
      "title_en": "Existence with あります",
      "description_it": "あります si usa per cose inanimate.",
      "description_en": "あります is used for inanimate things.",
      "pattern": "N に N が あります"
    },
    {
      "id": "animate",
      "category": "existence",
      "title_it": "Esistenza con います",
      "title_en": "Existence with います",
      "description_it": "います si usa per persone e animali.",
      "description_en": "います is used for people and animals.",
      "pattern": "N に N が います"
    },
    {
      "id": "i-adjective",
      "category": "adjectives",
      "title_it": "Aggettivi in い",
      "title_en": "い adjectives",
      "description_it": "Un aggettivo in い descrive un nome o conclude una frase.",
      "description_en": "An い adjective describes a noun or ends a sentence.",
      "pattern": "い adjective + N / N は い adjective"
    },
    {
      "id": "na-adjective",
      "category": "adjectives",
      "title_it": "Aggettivi in な",
      "title_en": "な adjectives",
      "description_it": "Usa な prima di un nome.",
      "description_en": "Use な before a noun.",
      "pattern": "な adjective + N"
    },
    {
      "id": "adjective-negative",
      "category": "adjectives",
      "title_it": "Negazione degli aggettivi in い",
      "title_en": "Negative い adjectives",
      "description_it": "くない nega un aggettivo in い.",
      "description_en": "くない negates an い adjective.",
      "pattern": "い → くないです"
    },
    {
      "id": "because",
      "category": "connections",
      "title_it": "Motivo con から",
      "title_en": "Reason with から",
      "description_it": "から introduce il motivo.",
      "description_en": "から gives the reason.",
      "pattern": "S から S"
    },
    {
      "id": "like",
      "category": "adjectives",
      "title_it": "Preferenze con 好き",
      "title_en": "Preferences with 好き",
      "description_it": "好き usa が per ciò che piace.",
      "description_en": "好き uses が for what you like.",
      "pattern": "N が 好きです"
    },
    {
      "id": "from-to",
      "category": "particles",
      "title_it": "Da… a…",
      "title_en": "From… to…",
      "description_it": "から e まで indicano gli estremi.",
      "description_en": "から and まで mark endpoints.",
      "pattern": "N から N まで"
    }
  ],
