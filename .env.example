# Copy to .env; replace before startup. Never commit .env.
APP_PASSWORD=replace-with-a-random-password-of-at-least-16-characters
APP_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
DATABASE_PATH=var/trainer.sqlite3
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GENERATION_PROVIDER=openai
EVALUATION_PROVIDER=openai
GENERATION_MODEL=local-model
EVALUATION_MODEL=local-model
# Optional MCP for host execution. JSON args; enable MCP in Settings and sync.
# Bunpro example:
# BUNPRO_MCP_COMMAND=npx
# BUNPRO_MCP_ARGS=["-y","bunpro-mcp-server"]
# BUNPRO_API_TOKEN=il-tuo-token-bunpro
BUNPRO_MCP_COMMAND=
BUNPRO_MCP_ARGS=[]
BUNPRO_API_TOKEN=
# WaniKani example:
# WANIKANI_MCP_COMMAND=npx
# WANIKANI_MCP_ARGS=["-y","kani-mcp-server"]
# WANIKANI_API_TOKEN=il-tuo-token-wanikani
WANIKANI_MCP_COMMAND=
WANIKANI_MCP_ARGS=[]
WANIKANI_API_TOKEN=
# The Docker MCP overlay installs both published packages; no local dist paths are needed.
